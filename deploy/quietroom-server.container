#
# QuietRoom server as a systemd service with ROOTLESS Podman (Quadlet), run by
# an unprivileged system user. Needs cgroup v2 (Enterprise Linux 9, current
# Debian/Ubuntu/Fedora); on cgroup v1 hosts use deploy/rootful/.
#
# Install (as root):
#   useradd --system --create-home --home-dir /var/lib/quietroom \
#           --shell /sbin/nologin quietroom
#   echo "quietroom:200001:65536" >> /etc/subuid
#   echo "quietroom:200001:65536" >> /etc/subgid
#   loginctl enable-linger quietroom          # start its services at boot
#   # build the image as that user (folder with DOCKERFILE + quietroom_server,
#   # readable by quietroom), then install this unit:
#   cd /tmp && sudo -u quietroom XDG_RUNTIME_DIR=/run/user/$(id -u quietroom) \
#       podman build -f /var/lib/quietroom/build/DOCKERFILE \
#       -t localhost/quietroom-server /var/lib/quietroom/build
#   install -d -o quietroom -g quietroom /var/lib/quietroom/.config/containers/systemd
#   install -o quietroom -g quietroom -m 0640 deploy/quietroom-server.container \
#       /var/lib/quietroom/.config/containers/systemd/
#   systemctl --user -M quietroom@ daemon-reload
#   systemctl --user -M quietroom@ start quietroom-server
# Manage: systemctl --user -M quietroom@ status quietroom-server
# Logs:   journalctl _SYSTEMD_USER_UNIT=quietroom-server.service -f
# Access file: /var/lib/quietroom/.local/share/containers/storage/volumes/quietroom-data/_data/
#
# Isolation:
# - Nothing runs as root: Podman and conmon run as "quietroom" (no shell, no
#   sudo); the server runs as container uid/gid 65532, which with the
#   subordinate ids above is host uid/gid 265532, an id with no account.
# - Read-only image, no capabilities, no privilege escalation, memory and
#   process limits (cgroup v2 delegates memory and pids to user services).
# - Host network: the server only answers on port 37842 (open it in the host
#   firewall); there is no NAT that a firewall reload could remove. Pair it
#   with deploy/quietroom-guard.nft, which blocks every outbound connection
#   from uid 265532 and keeps "quietroom" away from cloud metadata services.
# podman logs -f needs Podman events in journald, e.g. in
# /etc/containers/containers.conf.d/50-events-journald.conf:
#   [engine]
#   events_logger = "journald"

[Unit]
Description=QuietRoom server (rootless)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/quietroom-server
ContainerName=quietroom-server
User=65532
Group=65532
Network=host
# :U gives the volume to the container user, also after an upgrade from an
# image that ran as uid 1000.
Volume=quietroom-data:/app:U
DropCapability=all
NoNewPrivileges=true
ReadOnly=true
LogDriver=journald
PodmanArgs=--memory=512m --memory-swap=1g --pids-limit=256

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
